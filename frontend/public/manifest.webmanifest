{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "Restaurant OS — Digital Menu & QR System",
  "short_name": "Restaurant OS",
  "description": "Commission-free digital menus, dynamic QR table stands, and instant menu management for modern restaurants.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0F172A",
  "theme_color": "#F97316",
  "categories": ["food", "business", "productivity", "utilities"],
  "lang": "en",
  "dir": "ltr",
  "icons": [
    {
      "src": "/favicon-16x16.png",
      "sizes": "16x16",
      "type": "image/png"
    },
    {
      "src": "/favicon-32x32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/android-chrome-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/android-chrome-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/favicon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Features",
      "url": "/features",
      "description": "Explore dynamic QR stand and menu builder features"
    },
    {
      "name": "Login",
      "url": "/login",
      "description": "Access your restaurant dashboard"
    }
  ]
}
