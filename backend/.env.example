# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/restaurant_os?schema=public

# JWT Security
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters

# Frontend URL (For CORS and redirect links)
FRONTEND_URL=http://localhost:5173

# Optional SMTP Settings (If empty, Ethereal Mail is dynamically used)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Restaurant OS" <no-reply@restaurantos.com>
